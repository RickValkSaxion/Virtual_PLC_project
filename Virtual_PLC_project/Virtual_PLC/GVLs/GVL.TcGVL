<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <GVL Name="GVL" Id="{ad7c7aee-8066-4b1e-a7a7-313bc232cde0}">
    <Declaration><![CDATA[{attribute 'qualified_only'}
VAR_GLOBAL
	// Keuzes van de klant
	typeVerf 	: STRING := 'null';
	merkVerf 	: STRING := 'null';
	kleurVerf	: STRING := 'null';
	hoeveelVerf : STRING := 'null';
	
	// Opdracht voor kleurmachine
	verfOrder 	: ARRAY[1..4] OF STRING;
	
	// knoppen/sensoren kleurmachine
	homeKnop : BOOL;
	okeKnop : BOOL;
	blikPresent : BOOL;
	opdrachtKnop : BOOL;
	startKnop : BOOL;	
	
	barcodeBlik : INT;
	
	// klant variabelen
	klantWiltVerf : BOOL := TRUE;
	klantWordtGeholpen : BOOL;
	klantWacht : BOOL;
	verfAanKlantGegeven : BOOL;
	
	// schudmachine variabelen
	schudmachineReady : BOOL := FALSE;
	schudMachineBezig : BOOL := FALSE;
	deurDicht : BOOL := FALSE;
	stopSchudden : BOOL := FALSE;
END_VAR]]></Declaration>
  </GVL>
</TcPlcObject>